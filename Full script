--============================================================
-- ENTITY NAME DETECTION
--============================================================

local function isEntityLikeName(
	name
)

	if not name then
		return false
	end

	local s =
		tostring(name):lower()

	local patterns = {

		"repentance",
		"seek",
		"rush",
		"ambush",
		"smiler",
		"silence",
		"ripper",
		"rebound",
		"a60",
		"nightmare",
		"wh1t3",
		"hunger",
		"blink",
		"cease",
		"shock",
		"green",
		"black",
		"smile",
		"entity",
		"monster",
		"depth"
	}

	for _, pattern in ipairs(
		patterns
	) do

		if s:find(
			pattern,
			1,
			true
		) then

			return true
		end
	end

	return false
end

--============================================================
-- COUNT TRACKED ENTITIES
--============================================================

local function countTrackedEntities()

	local count = 0

	for model in pairs(
		ModelToSource
	) do

		if model
			and model.Parent
		then

			count += 1

		else

			ModelToSource[model] =
				nil

		end
	end

	return count
end

--============================================================
-- TRACK NEW ENTITY
--============================================================

Workspace.DescendantAdded:Connect(
	function(desc)

		if not desc
			or not desc:IsA("Model")
		then
			return
		end

		if desc:GetAttribute(
			"OD_TRACKED"
		) then
			return
		end

		if not isEntityLikeName(
			desc.Name
		) then
			return
		end

		desc:SetAttribute(
			"OD_TRACKED",
			true
		)

		ModelToSource[desc] =
			"external"

		local now = tick()

		for i =
			#RecentSpawnAttempts,
			1,
			-1
		do

			local attempt =
				RecentSpawnAttempts[i]

			if not attempt
				or (
					now -
					attempt.time
				) > 6
			then

				table.remove(
					RecentSpawnAttempts,
					i
				)

			elseif not attempt.matched then

				attempt.matched = true

				ModelToSource[desc] =
					attempt.url

				if attempt.url then

					PerURLLastSuccess[
						attempt.url
					] = now

				end

				break
			end
		end

		ActiveEntityCount =
			countTrackedEntities()

		local connection

		connection =
			desc.AncestryChanged:Connect(
				function(_, parent)

					if parent then
						return
					end

					if connection then

						pcall(function()

							connection:Disconnect()

						end)

					end

					ModelToSource[desc] =
						nil

					ActiveEntityCount =
						countTrackedEntities()

				end
			)
	end
)

