local function getCurrentRoomNumber()

	local gameData =
		RS:FindFirstChild(
			"GameData"
		)

	local latestRoom =
		gameData
		and gameData:FindFirstChild(
			"LatestRoom"
		)

	if latestRoom then

		local value =
			tonumber(
				latestRoom.Value
			)

		if value then
			return value
		end
	end

	local currentRooms =
		Workspace:FindFirstChild(
			"CurrentRooms"
		)

	if currentRooms then

		local highest = nil

		for _, room in ipairs(
			currentRooms:GetChildren()
		) do

			local n =
				tonumber(room.Name)

			if n
				and (
					not highest
					or n > highest
				)
			then

				highest = n

			end
		end

		return highest
	end

	return nil
end

