	task.spawn(function()

		task.wait(0.08)

		pcall(function()

			local startColor =
				Lighting.FogColor

			local startAmbient =
				Lighting.Ambient

			local startBrightness =
				Lighting.Brightness

			local steps = 10

			for i = 1, steps do

				local t =
					i / steps

				Lighting.FogColor =
					startColor:Lerp(
						targetColor,
						t
					)

				Lighting.Ambient =
					startAmbient:Lerp(
						targetAmbient,
						t
					)

				Lighting.FogStart = 0

				Lighting.FogEnd =
					endFog * t

				Lighting.Brightness =
					startBrightness *
					(
						1 -
						0.06 * t
					)

				task.wait(0.07)
			end

			Lighting.FogColor =
				targetColor

			Lighting.FogStart = 0
			Lighting.FogEnd = endFog

			Lighting.Ambient =
				targetAmbient

		end)
	end)
end

