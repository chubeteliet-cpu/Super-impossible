local function getMainGameModuleDelta()

	if not LocalPlayer then
		return nil
	end

	pcall(function()

		LocalPlayer:WaitForChild(
			"PlayerGui",
			8
		)

	end)

	local pg =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	if not pg then
		return nil
	end

	local mainui =
		pg:FindFirstChild("MainUI")
		or pg:FindFirstChild("Main")
		or pg:FindFirstChild("InGameUI")

	if not mainui then
		return nil
	end

	local initiator =
		mainui:FindFirstChild(
			"Initiator"
		)
		or mainui

	local mg =
		initiator:FindFirstChild(
			"Main_Game"
		)
		or mainui:FindFirstChild(
			"Main_Game"
		)

	if mg
		and mg:IsA("ModuleScript")
	then

		local ok, mod =
			pcall(require, mg)

		if ok
			and type(mod) == "table"
			and type(mod.caption) == "function"
		then
			return mod
		end
	end

	for _, desc in ipairs(
		mainui:GetDescendants()
	) do

		if desc:IsA("ModuleScript")
			and tostring(desc.Name)
				:lower()
				:find(
					"main_game",
					1,
					true
				)
		then

			local ok, mod =
				pcall(require, desc)

			if ok
				and type(mod) == "table"
				and type(mod.caption) == "function"
			then
				return mod
			end
		end
	end

	return nil
end

