--============================================================
-- SAFE WAIT
--============================================================

local function waitFor(cond, timeout, step)
	timeout = timeout or 8
	step = step or 0.12

	local t = 0

	while t < timeout do
		local ok, result = pcall(cond)

		if ok and result then
			return true
		end

		task.wait(step)
		t += step
	end

	local ok, result = pcall(cond)
	return ok and result == true
end

