-- RANDOM ENTITY URL
--============================================================

local function getRandomEntityURL()

	local available = {}

	-- Không trùng entity vừa spawn
	-- + ưu tiên entity hết cooldown

	for _, url in ipairs(
		ENTITY_URLS
	) do

		if url ~= LastSpawnedURL then

			local lastTime =
				PerURLLastSuccess[url]
				or 0

			if
				tick() - lastTime
				>= PER_ENTITY_COOLDOWN
			then

				table.insert(
					available,
					url
				)

			end
		end
	end

	-- Nếu tất cả đang cooldown
	-- vẫn tránh entity vừa spawn

	if #available == 0 then

		for _, url in ipairs(
			ENTITY_URLS
		) do

			if url ~= LastSpawnedURL then

				table.insert(
					available,
					url
				)

			end
		end
	end

	-- Nếu chỉ còn 1 entity
	if #available == 0 then

		for _, url in ipairs(
			ENTITY_URLS
		) do

			table.insert(
				available,
				url
			)

		end
	end

	if #available == 0 then
		return nil
	end

	return available[
		math.random(
			1,
			#available
		)
	]
end

--============================================================
-- EXECUTE ENTITY SCRIPT
--============================================================

local function trySpawnFromUrl(
	url,
	roomNumber
)

	if not url
		or url == ""
	then

		return false,
			"no_url"
	end

	if ActiveEntityCount
		>= MAX_ACTIVE_ENTITIES
	then

		return false,
			"entity_active"
	end

	local attempt = {

		url = url,

		room = roomNumber,

		time = tick(),

		matched = false
	}

	table.insert(
		RecentSpawnAttempts,
		attempt
	)

	-- Cleanup attempt cũ

	for i =
		#RecentSpawnAttempts,
		1,
		-1
	do

		local data =
			RecentSpawnAttempts[i]

		if not data
			or tick() -
				data.time > 15
		then

			table.remove(
				RecentSpawnAttempts,
				i
			)
		end
	end

	local ok, body =
		pcall(function()

			return game:HttpGet(
				url,
				true
			)

		end)

	if not ok
		or type(body) ~= "string"
		or #body < 8
	then

		return false,
			"fetch_failed"
	end

	local success, runError =
		pcall(function()

			local fn =
				loadstring(body)

			if type(fn)
				~= "function"
			then

				error(
					"loadstring_failed"
				)
			end

			fn()

		end)

	if not success then

		return false,
			"run_error:" ..
			tostring(runError)
	end

	LastSpawnedURL = url
	LastSpawnedName = url

	PerURLLastSuccess[url] =
		tick()

	log(
		"Entity script executed:",
		url,
		"| Room:",
		roomNumber
	)

	return true,
		"success"
end

--============================================================
-- RANDOM ROOM SCHEDULER
--============================================================

task.spawn(function()

	local LatestRoom = nil

	-- Chờ LatestRoom

	local waitStart =
		tick()

	while
		tick() - waitStart < 20
	do

		local gameData =
			RS:FindFirstChild(
				"GameData"
			)

		if gameData then

			LatestRoom =
				gameData:FindFirstChild(
					"LatestRoom"
				)

			if LatestRoom then
				break
			end
		end

		task.wait(0.25)
	end

	--========================================================
	-- FALLBACK ROOM SCANNER
	--========================================================

	if not LatestRoom then

		warnLog(
			"LatestRoom not found, using fallback room scanner."
		)

		local roomNow =
			getCurrentRoomNumber()
			or 0

		local nextSpawnRoom

		if roomNow < START_ROOM then

			nextSpawnRoom =
				START_ROOM

		else

			nextSpawnRoom =
				roomNow +
				math.random(
					MIN_ROOM_GAP,
					MAX_ROOM_GAP
				)
		end

		local lastGlobalSpawn = 0

		while true do

			task.wait(0.35)

			roomNow =
				getCurrentRoomNumber()

			if not roomNow
				or roomNow < START_ROOM
			then

				continue
			end

			if roomNow < nextSpawnRoom then
				continue
			end

			ActiveEntityCount =
				countTrackedEntities()

			--================================================
			-- ACTIVE ENTITY CHECK
			--================================================

			if
				ActiveEntityCount
				>= MAX_ACTIVE_ENTITIES
			then

				log(
					"Fallback blocked:",
					"ActiveEntityCount =",
					ActiveEntityCount
				)

				nextSpawnRoom =
					roomNow +
					math.random(
						2,
						4
					)

				continue
			end

			--================================================
			-- GLOBAL COOLDOWN
			--================================================

			if
				tick() -
				lastGlobalSpawn
				<
				GLOBAL_SPAWN_COOLDOWN
			then

				nextSpawnRoom =
					roomNow +
					math.random(
						1,
						3
					)

				continue
			end

			--================================================
			-- RANDOM ENTITY
			--================================================

			local randomURL =
				getRandomEntityURL()

			local success = false

			if randomURL then

				local spawnSuccess,
					reason =
					trySpawnFromUrl(
						randomURL,
						roomNow
					)

				success =
					spawnSuccess

				if spawnSuccess then

					lastGlobalSpawn =
						tick()

					log(
						"SPAWN SUCCESS | ROOM",
						roomNow
					)

				else

					log(
						"Spawn failed:",
						tostring(reason)
					)
				end
			end

			--================================================
			-- FALLBACK
			--================================================

			if not success then

				spawnPlaceholder(
					roomNow
				)

				lastGlobalSpawn =
					tick()
			end

			--================================================
			-- NEXT RANDOM ROOM
			--================================================

			nextSpawnRoom =
				roomNow +
				math.random(
					MIN_ROOM_GAP,
					MAX_ROOM_GAP
				)

			log(
				"Next spawn scheduled at Room",
				nextSpawnRoom
			)
		end

		return
	end

	--========================================================
	-- NORMAL LATESTROOM SCHEDULER
	--========================================================

	local currentRoom =
		tonumber(
			LatestRoom.Value
		)
		or 0

	local nextSpawnRoom

	-- Không spawn trước Room 8

	if currentRoom < START_ROOM then

		nextSpawnRoom =
			START_ROOM

	else

		nextSpawnRoom =
			currentRoom +
			math.random(
				MIN_ROOM_GAP,
				MAX_ROOM_GAP
			)
	end

	local lastProcessedRoom =
		tonumber(
			LatestRoom.Value
		)
		or 0

	local lastGlobalSpawn = 0

	log(
		"===================================="
	)

	log(
		"NEW RANDOM ENTITY SCHEDULER STARTED"
	)

	log(
		"START ROOM:",
		START_ROOM
	)

	log(
		"MIN GAP:",
		MIN_ROOM_GAP
	)

	log(
		"MAX GAP:",
		MAX_ROOM_GAP
	)

	log(
		"FIRST SPAWN:",
		nextSpawnRoom
	)

	log(
		"===================================="
	)

	--========================================================
	-- ROOM CHANGED
	--========================================================

	LatestRoom.Changed:Connect(
		function(value)

			local roomNow =
				tonumber(value)

			if not roomNow then
				return
			end

			if roomNow <= lastProcessedRoom then
				return
			end

			lastProcessedRoom =
				roomNow

			if roomNow < START_ROOM then
				return
			end

			if roomNow < nextSpawnRoom then
				return
			end

			ActiveEntityCount =
				countTrackedEntities()

			--================================================
			-- ENTITY ACTIVE
			--================================================

			if
				ActiveEntityCount
				>= MAX_ACTIVE_ENTITIES
			then

				log(
					"SPAWN SKIPPED:",
					"entity still active"
				)

				nextSpawnRoom =
					roomNow +
					math.random(
						2,
						4
					)

				return
			end

			--================================================
			-- GLOBAL COOLDOWN
			--================================================

			if
				tick() -
				lastGlobalSpawn
				<
				GLOBAL_SPAWN_COOLDOWN
			then

				log(
					"GLOBAL COOLDOWN ACTIVE"
				)

				nextSpawnRoom =
					roomNow +
					math.random(
						1,
						3
					)

				return
			end

			--================================================
			-- RANDOM ENTITY
			--================================================

			local randomURL =
				getRandomEntityURL()

			local spawned = false

			if randomURL then

				log(
					"================================"
				)

				log(
					"RANDOM ENTITY SELECTED"
				)

				log(
					"ROOM:",
					roomNow
				)

				log(
					"URL:",
					randomURL
				)

				log(
					"================================"
				)

				local success,
					reason =
					trySpawnFromUrl(
						randomURL,
						roomNow
					)

				if success then

					spawned = true

					lastGlobalSpawn =
						tick()

					log(
						"RANDOM ENTITY SPAWN SUCCESS!"
					)

				else

					log(
						"RANDOM ENTITY FAILED:",
						tostring(reason)
					)
				end
			end

			--================================================
			-- FALLBACK
			--================================================

			if not spawned then

				log(
					"ALL ENTITY ATTEMPTS FAILED."
				)

				log(
					"Using placeholder."
				)

				spawnPlaceholder(
					roomNow
				)

				lastGlobalSpawn =
					tick()
			end

			--================================================
			-- NEXT SPAWN
			--================================================

			local gap =
				math.random(
					MIN_ROOM_GAP,
					MAX_ROOM_GAP
				)

			nextSpawnRoom =
				roomNow + gap

			log(
				"--------------------------------"
			)

			log(
				"NEXT RANDOM SPAWN:",
				nextSpawnRoom
			)

			log(
				"ROOM GAP:",
				gap
			)

			log(
				"--------------------------------"
			)
		end
	)
end)

